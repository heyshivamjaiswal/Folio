generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Bookmark {
  id           Int      @id @default(autoincrement())
  userId       String
  title        String
  url          String?
  type         String
  createdAt    DateTime @default(now())
  errorMessage String?
  status       String   @default("pending")
  storagePath  String?
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}
